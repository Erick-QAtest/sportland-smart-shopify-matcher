# SPORTLAND SMART x SHOPIFY V1.1 — READ ONLY
# Portable checkpoint. NO SECRETS INCLUDED.

# Verified Smart source used in the end-to-end run
SMART_SOURCE=csv
SMART_CSV_PATH=eventos_log.csv

# Direct Google Sheets source exists in the code but is not yet the default.
SMART_SPREADSHEET_ID=
SMART_SHEET_NAME=eventos_log
SMART_RANGE=A:V
GOOGLE_SERVICE_ACCOUNT_FILE=

SMART_DEMAND_EVENTS=PREGUNTA_TALLA_PRECIO,PREGUNTA_MODELO_ESPECIFICO,PRUEBA_MULTIPLES_MODELOS
SMART_ACCEPTED_STATUSES=LOGGED
INCLUDE_PHONE=false

# Verified Shopify store
SHOPIFY_SHOP=sportland-sales.myshopify.com

# Preferred V1.1 authentication: the program obtains its own access token at runtime.
# Put these values ONLY in your local .env. .env is ignored by Git.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional backward-compatible override. Leave empty when using client credentials.
SHOPIFY_ADMIN_ACCESS_TOKEN=

SHOPIFY_API_VERSION=2026-07
SHOPIFY_VARIANT_PAGE_SIZE=50
SHOPIFY_LOCATION_PAGE_SIZE=10
SHOPIFY_MAX_RETRIES=6
SHOPIFY_TIMEOUT_SECONDS=30
SHOPIFY_SIZE_OPTION_NAMES=Talla,Size,Tamaño,Tamano,Shoe Size
OUTPUT_DIR=artifacts
